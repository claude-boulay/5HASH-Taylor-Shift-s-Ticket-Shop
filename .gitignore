# Clé SSH : seule la publique serait sans risque, mais autant ne jamais y penser.
.keys/

# Mot de passe du coffre Ansible Vault.
.vault-pass

# State Terraform et fichiers de travail.
**/.terraform/
*.tfstate
*.tfstate.*
*.tfplan
.terraform.lock.hcl
crash.log
crash.*.log

# Installés par ansible-galaxy : se réinstallent depuis requirements.yml.
ansible/collections/
ansible/roles/geerlingguy.*

# Données persistées par Floci (conteneurs EC2/RDS, state interne).
floci-data/

# Rien de tel qu'un secret en clair oublié dans un .env de travail.
*.env
!*.env.j2
